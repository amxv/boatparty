---
import PixelBoat from "./PixelBoat.astro";
import Scene from "./Scene.astro";

// The pool, drawn as a harbor: one berth per possible member of a project's
// pool. `for` lists the acquisition steps that land on a berth, so the ladder
// can light up the berths each step would pick.
type Berth = {
  name: string;
  state: "running" | "warm" | "stopped" | "free";
  holder?: string;
  label: string;
  for: string;
};

const berths: Berth[] = [
  { name: "bp-app-1", state: "running", holder: "~/code/app", label: "running a command", for: "s1" },
  { name: "bp-app-2", state: "warm", holder: "~/code/review", label: "idle, stops soon", for: "s4" },
  { name: "bp-app-3", state: "running", holder: "~/wt/feature", label: "serving :3000", for: "" },
  { name: "bp-app-4", state: "stopped", label: "stopped, disk kept", for: "s2" },
  { name: "bp-app-5", state: "warm", label: "released, still up", for: "s2" },
  { name: "free", state: "free", label: "created on demand", for: "s3" },
  { name: "free", state: "free", label: "created on demand", for: "s3" },
  { name: "free", state: "free", label: "created on demand", for: "s3" }
];

const ladder = [
  { id: "s1", title: "Its own sandbox", body: "The checkout's sandbox from last time, warm, with its dependencies and build outputs." },
  { id: "s2", title: "A free one", body: "One no checkout holds, preferring a sandbox that is still running." },
  { id: "s3", title: "A new one", body: "Created on demand while the pool is below max_sandboxes, 8 by default." },
  { id: "s4", title: "An idle neighbour's", body: "First one whose checkout directory is gone, then one idle past steal_after_minutes." },
  { id: "s5", title: "Or it waits", body: "Up to acquire_wait_seconds, then fails with a message naming the limit." }
];
---

<section class="bp-section bp-section--panel hb" data-harbor data-hl="s1">
  <div class="shell">
    <div class="bp-head bp-reveal">
      <h2>A harbor for every project</h2>
      <p class="bp-sub">
        Each project owns a small pool of sandboxes. Every checkout and worktree keeps the one it
        used last, so the next command lands on a warm machine with its dependencies already
        installed.
      </p>
    </div>

    <div class="bp-reveal">
      <p class="bp-label hb__caption">pool app · max_sandboxes = 8</p>
      <Scene height={250} seaBands={4} seed={21} class="hb__scene">
        <ul class="hb__berths">
          {berths.map((berth, index) => (
            <li class="hb__berth" data-state={berth.state} data-for={berth.for} style={`--k:${index}`}>
              {berth.holder ? <span class="hb__holder">{berth.holder}</span> : <span class="hb__holder is-empty"></span>}
              <div class="hb__boat">
                {berth.state === "free" ? <span class="hb__ghost"></span> : <PixelBoat px={3.5} />}
              </div>
            </li>
          ))}
        </ul>
      </Scene>
      <ul class="hb__names" aria-label="Pool members">
        {berths.map((berth) => (
          <li data-state={berth.state} data-for={berth.for}>
            <strong>{berth.name}</strong>
            <span>{berth.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <ol class="hb__ladder">
      <li class="hb__ladder-title bp-label">Where a checkout's next command lands</li>
      {ladder.map((step, index) => (
        <li tabindex="0" data-step={step.id}>
          <span class="hb__num">{index + 1}</span>
          <strong>{step.title}</strong>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hb__caption {
    margin-bottom: 0.5rem;
  }

  .hb__berths,
  .hb__names {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hb__berths {
    position: absolute;
    inset: 0;
  }

  .hb__berth {
    position: relative;
    transition: opacity 0.35s ease;
  }

  .hb__holder {
    position: absolute;
    top: 26px;
    left: 50%;
    padding: 0.2rem 0.4rem;
    background: var(--c-cobalt);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .hb__holder.is-empty {
    display: none;
  }

  .hb__boat {
    position: absolute;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    animation: hb-bob 2.2s steps(2) infinite;
    animation-delay: calc(var(--k) * -0.4s);
  }

  @keyframes hb-bob {
    50% {
      bottom: 46px;
    }
  }

  [data-state="warm"] .hb__boat {
    --pb-blink: 0s;
  }

  [data-state="stopped"] .hb__boat {
    opacity: 0.35;
    animation: none;
    --pb-blink: 0s;
    --pb-lamp: transparent;
  }

  .hb__ghost {
    display: block;
    width: 63px;
    height: 24px;
    border: 2px dashed var(--c-t1);
    border-top: 0;
  }

  [data-state="free"] .hb__boat {
    animation: none;
  }

  .hb__names li {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.3rem 0;
    text-align: center;
    transition: opacity 0.35s ease;
  }

  .hb__names strong {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .hb__names span {
    color: var(--c-soft);
    font-size: 0.82rem;
    line-height: 1.3;
  }

  [data-state="free"] strong {
    color: var(--c-soft);
    font-weight: 400;
  }

  /* Highlights driven by the ladder. */

  .hb[data-hl] .hb__berth,
  .hb[data-hl] .hb__names li {
    opacity: 0.4;
  }

  .hb[data-hl="s1"] [data-for~="s1"],
  .hb[data-hl="s2"] [data-for~="s2"],
  .hb[data-hl="s3"] [data-for~="s3"],
  .hb[data-hl="s4"] [data-for~="s4"] {
    opacity: 1 !important;
  }

  .hb[data-hl="s1"] .hb__names [data-for~="s1"] strong,
  .hb[data-hl="s2"] .hb__names [data-for~="s2"] strong,
  .hb[data-hl="s3"] .hb__names [data-for~="s3"] strong,
  .hb[data-hl="s4"] .hb__names [data-for~="s4"] strong {
    color: var(--c-accent);
  }

  /* Ladder */

  .hb__ladder {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hb__ladder-title {
    grid-column: 1 / -1;
    margin-bottom: 1rem;
  }

  .hb__ladder li[data-step] {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1rem 0 0;
    border-top: 2px solid var(--c-line-strong);
    cursor: default;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .hb__num {
    color: var(--c-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .hb__ladder strong {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 400;
  }

  .hb__ladder p {
    color: var(--c-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .hb[data-hl="s1"] [data-step="s1"],
  .hb[data-hl="s2"] [data-step="s2"],
  .hb[data-hl="s3"] [data-step="s3"],
  .hb[data-hl="s4"] [data-step="s4"],
  .hb[data-hl="s5"] [data-step="s5"] {
    border-color: var(--c-cobalt);
  }

  .hb[data-hl="s1"] [data-step="s1"] .hb__num,
  .hb[data-hl="s2"] [data-step="s2"] .hb__num,
  .hb[data-hl="s3"] [data-step="s3"] .hb__num,
  .hb[data-hl="s4"] [data-step="s4"] .hb__num,
  .hb[data-hl="s5"] [data-step="s5"] .hb__num {
    color: var(--c-accent);
  }

  @media (max-width: 960px) {
    .hb__ladder {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }
  }

  @media (max-width: 760px) {
    .hb__holder,
    .hb__names span {
      display: none;
    }

    .hb__names strong {
      font-size: 0.55rem;
    }

    .hb__boat :global(svg) {
      width: 36px;
      height: auto;
    }

    .hb__ghost {
      width: 36px;
      height: 14px;
    }
  }
</style>
