---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
const commands = [
  {
    platform: "macOS and Linux",
    icons: ["apple", "linux"],
    command: "curl -fsSL https://boatparty.ashray.xyz/install.sh | sh"
  },
  {
    platform: "Windows (PowerShell)",
    icons: ["windows"],
    command: "irm https://boatparty.ashray.xyz/install.ps1 | iex"
  }
];
---

<div class:list={["bp-install", { "bp-install--dark": dark }]}>
  {commands.map(({ platform, icons, command }) => (
    <div class="bp-cmd bp-install__cmd">
      <span class="bp-install__platforms" role="img" aria-label={platform} title={platform}>
        {icons.map((icon) => <span class:list={["bp-install__icon", `bp-install__icon--${icon}`]}></span>)}
      </span>
      <code>{command}</code>
      <button class="bp-copy" type="button" data-copy={command} aria-label={`Copy ${platform} install command`}>copy</button>
    </div>
  ))}
</div>

<style>
  .bp-install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    min-width: 0;
    width: 100%;
  }

  .bp-install__cmd {
    min-width: 0;
    gap: 0.7rem;
  }

  .bp-install__platforms {
    display: inline-flex;
    align-items: center;
    flex: 0 0 2.5rem;
    gap: 0.4rem;
    color: var(--c-soft);
  }

  .bp-install__icon {
    display: block;
    width: 1rem;
    height: 1rem;
    background: currentColor;
    mask: var(--platform-icon) center / contain no-repeat;
  }

  .bp-install__icon--apple { --platform-icon: url("/icons/apple.svg"); }
  .bp-install__icon--linux { --platform-icon: url("/icons/linux.svg"); }
  .bp-install__icon--windows { --platform-icon: url("/icons/windows.svg"); }

  .bp-install--dark .bp-install__cmd {
    background: var(--c-deep);
    color: #fff;
  }

  .bp-install--dark .bp-install__platforms,
  .bp-install--dark .bp-copy {
    color: rgba(255, 255, 255, 0.75);
  }

  .bp-install--dark .bp-copy:hover,
  .bp-install--dark .bp-copy.is-copied {
    color: #fff;
  }
</style>
