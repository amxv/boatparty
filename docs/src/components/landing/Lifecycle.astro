---
// A sandbox's day on a 24-minute track. Positions are minutes on the track,
// matching the documented defaults (heartbeat 2, lease 5, idle 5).
type Span = { from: number; to: number; kind: "run" | "idle" | "stopped"; label: string };
type Mark = { at: number; kind: "start" | "stop"; label: string; sub: string };

const spans: Span[] = [
  { from: 0, to: 6, kind: "run", label: "cheers -- cargo test" },
  { from: 6, to: 8, kind: "idle", label: "" },
  { from: 8, to: 11, kind: "run", label: "cheers lint" },
  { from: 11, to: 16, kind: "idle", label: "idle 5 min" },
  { from: 16, to: 21, kind: "stopped", label: "stopped, costs nothing" },
  { from: 21, to: 24, kind: "run", label: "cheers test" }
];

const marks: Mark[] = [
  { at: 0, kind: "start", label: "1 start", sub: "created" },
  { at: 8, kind: "start", label: "0 starts", sub: "still warm" },
  { at: 16, kind: "stop", label: "auto-stop", sub: "disk kept" },
  { at: 21, kind: "start", label: "1 start", sub: "resumed" }
];

const heartbeats = [2, 4, 10];

const keys = [
  { key: "heartbeat_minutes", value: "2", body: "How often a running command pushes the sandbox's auto-stop forward." },
  { key: "lease_minutes", value: "5", body: "How far ahead that auto-stop stays. A client that dies leaves its sandbox up about this long." },
  { key: "idle_minutes", value: "5", body: "After the last command ends, the sandbox stops this much later. At most 15." }
];

const pct = (minute: number) => `${(minute / 24) * 100}%`;
---

<section class="bp-section lc">
  <div class="shell">
    <div class="bp-head bp-reveal">
      <h2>Warm while you work, asleep when you don't</h2>
      <p class="bp-sub">
        When a sandbox is already up, boatparty makes no call to boat before your command starts.
        When the last command ends, the sandbox stops by itself a few minutes later and keeps its
        disk, so leaving it alone is always the cheap choice.
      </p>
    </div>

    <div class="lc__chart bp-reveal">
      <div class="lc__track" aria-hidden="true">
        <div class="lc__marks">
          {marks.map((mark) => (
            <span class="lc__mark" data-kind={mark.kind} style={`left:${pct(mark.at)}`}>
              <b>{mark.label}</b>
              <small>{mark.sub}</small>
            </span>
          ))}
        </div>

        <div class="lc__bar">
          {spans.map((span) => (
            <span
              class="lc__span"
              data-kind={span.kind}
              style={`left:${pct(span.from)};width:${pct(span.to - span.from)}`}
            >
              {span.label && <em>{span.label}</em>}
            </span>
          ))}
          {heartbeats.map((minute) => (
            <i class="lc__beat" style={`left:${pct(minute)}`}></i>
          ))}
          <span class="lc__now"></span>
        </div>

        <div class="lc__lease">
          <span style={`left:${pct(0)};width:${pct(11)}`}>
            auto-stop rides 5 min ahead while commands run
          </span>
        </div>

        <div class="lc__axis">
          {[0, 4, 8, 12, 16, 20, 24].map((minute) => (
            <span style={`left:${pct(minute)}`}>{minute}m</span>
          ))}
        </div>
      </div>

      <p class="lc__caption">
        One sandbox across 24 minutes: a create, a warm second command, an idle stop, a resume.
        Heartbeats <span class="lc__beat-key"></span> keep it up while anything runs.
      </p>
    </div>

    <dl class="lc__keys">
      {keys.map((item, index) => (
        <div class="bp-reveal" style={`--d:${index * 0.08}s`}>
          <dt><code>{item.key}</code><span>{item.value}</span></dt>
          <dd>{item.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .lc__chart {
    padding: clamp(1.2rem, 3vw, 2rem) clamp(1.2rem, 3vw, 2.2rem) 1.4rem;
    border: 1px solid var(--c-t2);
  }

  .lc__track {
    position: relative;
    margin: 0 0.4rem;
  }

  .lc__marks {
    position: relative;
    height: 3.6rem;
  }

  .lc__mark {
    position: absolute;
    bottom: 0;
    display: grid;
    padding: 0 0 0.8rem 0.55rem;
    border-left: 1px dotted var(--c-t1);
    line-height: 1.25;
    white-space: nowrap;
  }

  .lc__mark b {
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
  }

  .lc__mark small {
    color: var(--c-soft);
    font-size: 0.82rem;
  }

  .lc__mark[data-kind="stop"] b {
    color: var(--c-soft);
  }

  .lc__bar {
    position: relative;
    height: 2.75rem;
    background: var(--c-panel);
  }

  .lc__span {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .lc__span em {
    overflow: hidden;
    font-style: normal;
    text-overflow: ellipsis;
  }

  .lc__span[data-kind="run"] {
    background: var(--c-cobalt);
    color: #fff;
  }

  .lc__span[data-kind="idle"] {
    background: linear-gradient(90deg, var(--c-t1), var(--c-t2) 40%, var(--c-t4));
    color: #fff;
  }

  .lc__span[data-kind="stopped"] {
    border: 2px dotted var(--c-t2);
    color: var(--c-soft);
  }

  .lc__beat {
    position: absolute;
    top: -0.55rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    background: var(--c-cobalt);
  }

  .lc__beat-key {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 0.2rem;
    vertical-align: 0.15em;
    background: var(--c-cobalt);
  }

  .lc__now {
    position: absolute;
    top: -0.8rem;
    bottom: -0.8rem;
    left: 0;
    width: 2px;
    background: var(--c-ink);
    opacity: 0.6;
    animation: lc-sweep 14s steps(96) infinite;
  }

  @keyframes lc-sweep {
    to {
      left: 100%;
    }
  }

  .lc__lease {
    position: relative;
    height: 2.2rem;
  }

  .lc__lease span {
    position: absolute;
    top: 0.55rem;
    padding-top: 0.35rem;
    border-top: 2px dotted var(--c-cobalt);
    color: var(--c-accent);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .lc__axis {
    position: relative;
    height: 1.2rem;
    border-top: 1px solid var(--c-line);
  }

  .lc__axis span {
    position: absolute;
    top: 0.3rem;
    color: var(--c-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    transform: translateX(-50%);
  }

  .lc__axis span:first-child {
    transform: none;
  }

  .lc__axis span:last-child {
    transform: translateX(-100%);
  }

  .lc__caption {
    margin-top: 1.2rem;
    color: var(--c-text);
    font-size: 0.95rem;
  }

  .lc__keys {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
  }

  .lc__keys > div {
    padding-top: 1rem;
    border-top: 2px solid var(--c-line-strong);
  }

  .lc__keys dt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .lc__keys dt code {
    color: var(--c-soft);
    font-size: 0.8rem;
  }

  .lc__keys dt span {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    line-height: 1;
  }

  .lc__keys dt span::after {
    margin-left: 0.2rem;
    color: var(--c-soft);
    content: "min";
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .lc__keys dd {
    margin: 0.6rem 0 0;
    color: var(--c-text);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .lc__chart {
      overflow-x: auto;
    }

    .lc__track {
      min-width: 40rem;
    }

    .lc__keys {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
