---
import PixelBoat from "./PixelBoat.astro";

// Starts and limits. The tracks are illustrative shapes, not measurements.
const windows = [
  { name: "per minute", used: 34, reserve: 0, rule: "boat's own limit: retried after the delay boat names" },
  { name: "per hour", used: 58, reserve: 18, rule: "your budgets and the reserve wait with one log line; boat's own limit is retried" },
  { name: "per day", used: 27, reserve: 14, rule: "budgets still wait; boat's own daily limit is the only one that fails" }
];
---

<section class="bp-section bp-section--panel lm">
  <div class="shell lm__grid">
    <div>
      <div class="bp-reveal">
        <h2>Starts are scarce. Spend them on purpose.</h2>
        <p class="bp-sub">
          boat counts every create and every resume onto a new machine as a start, and never
          queues one. boatparty sends every start from every project through one local ledger,
          reconciled with boat's own counts, so an over-budget start waits instead of failing.
        </p>
      </div>

      <ul class="lm__tracks bp-reveal" style="--d:0.1s">
        {windows.map((w) => (
          <li>
            <span class="bp-label">starts {w.name}</span>
            <div class="lm__track" style={`--used:${w.used}%;--reserve:${w.reserve}%`}>
              <span class="lm__used"></span>
              {w.reserve > 0 && <span class="lm__reserve">reserve</span>}
              <span class="lm__boat"><PixelBoat px={2} /></span>
            </div>
            <p>{w.rule}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="lm__file bp-reveal" style="--d:0.1s">
      <div class="bp-term">
        <div class="bp-term__bar">~/.config/boatparty/account.toml</div>
        <div class="bp-term__body">
          <span class="t-dim"># every project on this machine, one file</span>
          <span class="t-note">[account]</span>
          <span>max_running            = 4</span>
          <span>reserve_starts_per_day = 20</span>
          <span>&nbsp;</span>
          <span class="t-note">[projects.app]</span>
          <span>max_sandboxes   = 3</span>
          <span>starts_per_hour = 10</span>
          <span>idle_minutes    = 5</span>
        </div>
      </div>
      <div class="lm__cmds">
        <div class="bp-cmd lm__cmd">
          <span class="bp-cmd__prompt" aria-hidden="true">$</span>
          <code>boatparty limits</code>
        </div>
        <p>Starts left in each window, running sandboxes, and each project's usage this month.</p>
        <div class="bp-cmd lm__cmd">
          <span class="bp-cmd__prompt" aria-hidden="true">$</span>
          <code>boatparty limits set project app starts_per_hour=10</code>
        </div>
        <p>Edits the file in place and keeps its comments.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .lm {
    --pb-hull: var(--c-cobalt);
    --pb-keel: var(--c-deep);
    --pb-deck: var(--c-t1);
    --pb-cabin: var(--c-cobalt);
    --pb-win: #ffffff;
    --pb-flag: var(--c-t1);
    --pb-lamp: var(--c-cobalt);
  }

  .lm__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .lm__tracks {
    display: grid;
    gap: 1.9rem;
    margin: 2.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .lm__track {
    position: relative;
    height: 26px;
    margin-top: 0.35rem;
    background: linear-gradient(90deg, var(--c-t1) 2px, transparent 2px) 0 bottom / 10px 2px repeat-x;
  }

  .lm__used {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--used);
    height: 2px;
    background: var(--c-cobalt);
    transform-origin: left;
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s;
  }

  .lm__boat {
    position: absolute;
    bottom: 0;
    left: var(--used);
    transform: translateX(-60%);
    transition: left 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s;
  }

  :global(.bp-js) .lm__tracks:not(.is-in) .lm__used {
    transform: scaleX(0);
  }

  :global(.bp-js) .lm__tracks:not(.is-in) .lm__boat {
    left: 0;
  }

  .lm__reserve {
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--reserve);
    height: 26px;
    padding-left: 0.4rem;
    border-left: 2px solid var(--c-t2);
    background: repeating-linear-gradient(135deg, var(--c-t3) 0 2px, transparent 2px 6px);
    color: var(--c-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 26px;
  }

  .lm__tracks p {
    margin-top: 0.5rem;
    color: var(--c-text);
    font-size: 0.95rem;
  }

  .lm__file {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
  }

  .lm__file .bp-term__body {
    font-size: 0.86rem;
  }

  .lm__cmds {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .lm__cmd {
    background: var(--c-bg);
  }

  .lm__cmds p {
    margin: 0 0 0.6rem;
    color: var(--c-text);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .lm__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
