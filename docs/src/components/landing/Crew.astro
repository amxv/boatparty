---
const crew = [
  { name: "launch", flag: "diagonal", meaning: "Start this workspace's sandbox: create or resume it, then connect.", example: "boatparty launch" },
  { name: "cheers", flag: "check", meaning: "Sync, run one command, stream its output, return its exit code, bring its changes back.", example: "boatparty cheers -- cargo test" },
  { name: "load", flag: "bands", meaning: "Sync the working tree only.", example: "boatparty load" },
  { name: "cruise", flag: "cross", meaning: "Run a long-lived process, such as a dev server, with port forwards.", example: "boatparty cruise --forward 3000:3000 -- npm run dev" },
  { name: "board", flag: "halves", meaning: "Open a shell in the checkout, or run one command there without syncing.", example: "boatparty board" },
  { name: "dock", flag: "square", meaning: "Stop the sandbox now. Its disk is kept. Rarely needed: idle sandboxes stop by themselves.", example: "boatparty dock" }
];

const plain = ["init", "status", "pipe", "fetch", "forward", "expose", "limits", "pool", "log", "doctor", "base", "skill"];
---

<section class="bp-section bp-section--panel cw">
  <div class="shell">
    <div class="bp-head bp-reveal">
      <h2>Six words to remember</h2>
      <p class="bp-sub">
        The everyday commands are boat-party themed; everything else has a plain name.
        <code>boatparty &lt;command&gt; --help</code> documents each one.
      </p>
    </div>

    <ul class="cw__grid">
      {crew.map((member, index) => (
        <li class="cw__card bp-reveal" style={`--d:${(index % 3) * 0.07}s`}>
          <span class="cw__flag" data-flag={member.flag} aria-hidden="true"></span>
          <h3>{member.name}</h3>
          <p>{member.meaning}</p>
          <code class="cw__ex">{member.example}</code>
        </li>
      ))}
    </ul>

    <p class="cw__plain bp-reveal">
      <span>also aboard:</span>
      {plain.map((name) => <code>{name}</code>)}
    </p>
  </div>
</section>

<style>
  .cw__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 1px;
    background: var(--c-line-strong);
    list-style: none;
  }

  .cw__card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.7rem;
    padding: 1.8rem 1.6rem 1.6rem;
    background: var(--c-bg);
  }

  .cw__card h3 {
    margin: 0.5rem 0 0;
    font-size: 2rem;
    line-height: 1;
  }

  .cw__card p {
    color: var(--c-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  .cw__ex {
    overflow: hidden;
    color: var(--c-soft);
    font-size: 0.76rem !important;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cw__ex::before {
    margin-right: 0.5rem;
    content: "$";
  }

  /* Signal flags: one pixel pattern per command, on a short pole. */

  .cw__flag {
    position: relative;
    width: 40px;
    height: 28px;
    margin-left: 6px;
    image-rendering: pixelated;
    transition: transform 0.25s steps(2);
  }

  .cw__flag::before {
    position: absolute;
    top: -4px;
    bottom: -12px;
    left: -6px;
    width: 4px;
    background: var(--c-deep);
    content: "";
  }

  .cw__card:hover .cw__flag {
    transform: translateY(-4px);
  }

  [data-flag="diagonal"] {
    background: linear-gradient(135deg, var(--c-cobalt) 50%, var(--c-t3) 50%);
  }

  [data-flag="check"] {
    background:
      conic-gradient(var(--c-cobalt) 25%, var(--c-t4) 0 50%, var(--c-cobalt) 0 75%, var(--c-t4) 0) 0 0 / 10px 7px;
  }

  [data-flag="bands"] {
    background: linear-gradient(var(--c-cobalt) 0 33.3%, var(--c-t3) 0 66.6%, var(--c-cobalt) 0);
  }

  [data-flag="cross"] {
    background:
      linear-gradient(var(--c-t4), var(--c-t4)) 12px 0 / 6px 100% no-repeat,
      linear-gradient(var(--c-t4), var(--c-t4)) 0 11px / 100% 6px no-repeat,
      var(--c-cobalt);
  }

  [data-flag="halves"] {
    background: linear-gradient(90deg, var(--c-t3) 50%, var(--c-deep) 50%);
  }

  [data-flag="square"] {
    background:
      linear-gradient(var(--c-cobalt), var(--c-cobalt)) center / 16px 12px no-repeat,
      var(--c-t3);
  }

  .cw__plain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    margin-top: 1.8rem;
    color: var(--c-text);
  }

  .cw__plain span {
    margin-right: 0.3rem;
    color: var(--c-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 960px) {
    .cw__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .cw__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
