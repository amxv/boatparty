---
import PixelBoat from "./PixelBoat.astro";
import PixelSea from "./PixelSea.astro";

const install = "curl -fsSL https://boatparty.ashray.xyz/install.sh | sh";

// Boats on the hero sea: x in %, y in px below the horizon, pixel size.
const fleet = [
  { x: 6, y: 14, px: 1.5, drift: 0, near: 0 },
  { x: 29, y: 10, px: 1.5, drift: 1, near: 0 },
  { x: 47, y: 22, px: 2, drift: 0, near: 0 },
  { x: 83, y: 18, px: 2, drift: 1, near: 0 },
  { x: 14, y: 96, px: 3, drift: 0, near: 0 },
  { x: 70, y: 150, px: 5, drift: 0, near: 1 }
];
---

<section class="bph">
  <div class="bph__sky">
    <div class="shell bph__copy">
      <h1 class="rise" style="--i:0">Warm Linux sandboxes for every Git checkout</h1>
      <p class="bph__lede rise" style="--i:1">
        boatparty mirrors your working tree to a warm boat.dev sandbox, runs the command with live
        output and its real exit code, and brings the changes back. For you, and for your coding
        agents.
      </p>
      <div class="bph__cta rise" style="--i:2">
        <div class="bp-cmd bph__cmd">
          <span class="bp-cmd__prompt" aria-hidden="true">$</span>
          <code>{install}</code>
          <button class="bp-copy" type="button" data-copy={install}>copy</button>
        </div>
        <a class="bph__docs" href="/docs/getting-started">Get started</a>
      </div>
    </div>
  </div>

  <div class="bph__sea">
    <PixelSea bands={9} band={28} seed={11} />
    <div class="bph__fleet">
      {fleet.map((boat, index) => (
        <div
          class:list={["bph__boat", boat.drift && "is-drifting", boat.near && "is-near"]}
          style={`left:${boat.x}%;top:${boat.y}px;--k:${index}`}
        >
          <PixelBoat px={boat.px} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bph {
    --pb-hull: #ffffff;
    --pb-keel: #929fd3;
    --pb-deck: #e0e3f2;
    --pb-cabin: #ffffff;
    --pb-win: #263fa9;
    --pb-flag: #c2c9e6;
    --pb-lamp: #fff6c8;
    --pb-lamp-off: #6b7cc4;
    background: var(--c-cobalt);
    color: #fff;
  }

  .bph__sky {
    padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(5rem, 9vw, 7rem);
  }

  .bph__copy {
    display: grid;
    gap: 1.6rem;
  }

  .bph h1 {
    max-width: 15ch;
    color: #fff;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .bph__lede {
    max-width: 38rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.55;
  }

  .bph__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }

  .bph__cmd {
    min-width: 0;
    flex: 0 1 37rem;
    background: var(--c-deep);
    color: #fff;
  }

  .bph__cmd .bp-cmd__prompt,
  .bph__cmd .bp-copy {
    color: rgba(255, 255, 255, 0.55);
  }

  .bph__cmd .bp-copy:hover,
  .bph__cmd .bp-copy.is-copied {
    color: #fff;
  }

  .bph__docs {
    display: inline-flex;
    align-items: center;
    padding: 0 1.5rem;
    min-height: 3rem;
    background: #fff;
    color: var(--c-cobalt);
    transition: background 0.2s ease;
  }

  .bph__docs:hover {
    background: #e0e3f2;
  }

  .bph__sea {
    position: relative;
  }

  .bph__fleet {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bph__boat {
    position: absolute;
    transform: translateY(-100%);
    animation: hero-bob 2.4s steps(2) infinite;
    animation-delay: calc(var(--k) * -0.45s);
  }

  .bph__boat.is-near {
    --pb-hull: var(--c-cobalt);
    --pb-keel: var(--c-deep);
    --pb-deck: #6b7cc4;
    --pb-cabin: var(--c-cobalt);
    --pb-win: #ffffff;
    --pb-flag: #6b7cc4;
    --pb-lamp: var(--c-cobalt);
    --pb-lamp-off: transparent;
  }

  :global(:root[data-theme="dark"]) .bph__boat.is-near {
    --pb-hull: #ffffff;
    --pb-keel: #929fd3;
    --pb-deck: #e0e3f2;
    --pb-cabin: #ffffff;
    --pb-win: #263fa9;
    --pb-flag: #c2c9e6;
    --pb-lamp: #fff6c8;
  }

  .bph__boat.is-drifting {
    animation:
      hero-bob 2.4s steps(2) infinite,
      hero-drift 70s linear infinite alternate;
    animation-delay: calc(var(--k) * -0.45s), calc(var(--k) * -11s);
  }

  @keyframes hero-bob {
    50% {
      transform: translateY(calc(-100% - 2px));
    }
  }

  @keyframes hero-drift {
    to {
      margin-left: 12vw;
    }
  }

  .rise {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 0.1s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 640px) {
    .bph__fleet > :nth-child(n + 5) {
      display: none;
    }

    .bph__docs {
      justify-content: center;
      width: 100%;
    }
  }
</style>
