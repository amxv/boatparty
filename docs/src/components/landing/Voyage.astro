---
// The hero diagram: one `cheers` command, played as three legs between this
// computer and the sandbox. The page script steps `data-step` forward; without
// it (or with reduced motion) every line is shown at once.
const files = [
  { path: "src/app.ts", tag: "rewritten", note: "changed here, so synced", tone: "buoy", at: 2 },
  { path: "src/app.test.ts", tag: "untouched", note: "same content, mtime kept", tone: "dim", at: 3 },
  { path: "package.json", tag: "untouched", note: "same content, mtime kept", tone: "dim", at: 3 },
  { path: "node_modules/", tag: "warm", note: "installed once, by lockfile", tone: "lamp", at: 3 }
];
---

<div class="vy" data-voyage data-phase="all">
  <div class="vy__head">
    <span class="vy__title">One command, three legs</span>
    <ol class="vy__phases" aria-hidden="true">
      <li data-leg="mirror"><i>01</i> Mirror</li>
      <li data-leg="run"><i>02</i> Run</li>
      <li data-leg="copy"><i>03</i> Copy back</li>
    </ol>
  </div>

  <div class="vy__grid">
    <div class="vy__local bp-term">
      <div class="bp-term__bar">
        <span class="bp-term__lights"><i></i><i></i><i></i></span>
        <span>~/code/app · your machine</span>
      </div>
      <div class="bp-term__body">
        <span data-at="1"><span class="t-p">$</span> <span class="vy__typed">boatparty cheers -- npm test -- -u</span></span>
        <span data-at="4" class="t-ok"> PASS  <span class="t-dim">src/</span>app.test.ts</span>
        <span data-at="5"> Tests:     42 passed, 42 total</span>
        <span data-at="6"> Snapshots: <span class="t-note">1 updated</span>, 41 passed</span>
        <span data-at="9" class="t-dim">boatparty: applied the command's changes locally: src/__snapshots__/app.test.ts.snap</span>
        <span data-at="10"><span class="t-p">$</span> echo $?</span>
        <span data-at="10" class="t-ok">0</span>
        <span class="vy__cursor" aria-hidden="true"></span>
      </div>
    </div>

    <div class="vy__channel" aria-hidden="true">
      <div class="vy__lane" data-lane="mirror">
        <span class="vy__lane-label">thin Git pack</span>
        <span class="vy__rope"></span>
        <span class="vy__packet vy__packet--out">1 file</span>
        <span class="vy__arrow">→</span>
      </div>
      <div class="vy__lane" data-lane="run">
        <span class="vy__lane-label">live output</span>
        <span class="vy__rope"></span>
        <span class="vy__drops"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="vy__arrow vy__arrow--back">←</span>
      </div>
      <div class="vy__lane" data-lane="copy">
        <span class="vy__lane-label">changes as a patch</span>
        <span class="vy__rope"></span>
        <span class="vy__packet vy__packet--in">.snap</span>
        <span class="vy__arrow vy__arrow--back">←</span>
      </div>
    </div>

    <div class="vy__remote">
      <div class="vy__remote-head">
        <span class="vy__lamp" aria-hidden="true"></span>
        <div>
          <strong>bp-app-1</strong>
          <small>Ubuntu 24.04 · x86_64 · /home/user/app</small>
        </div>
        <span class="vy__state">
          <span class="vy__state-run">running</span>
          <span class="vy__state-warm">warm · stops 5 min after the last command</span>
          <span class="vy__state-all">warm, reused by the next command</span>
        </span>
      </div>
      <ul class="vy__files">
        {files.map((file) => (
          <li data-at={file.at} data-tone={file.tone}>
            <code>{file.path}</code>
            <span class="vy__tag">{file.tag}</span>
            <span class="vy__note">{file.note}</span>
          </li>
        ))}
        <li data-at="7" data-tone="run" class="vy__new">
          <code>src/__snapshots__/app.test.ts.snap</code>
          <span class="vy__tag">changed</span>
          <span class="vy__note">by the command, sent home</span>
        </li>
      </ul>
    </div>
  </div>

  <ol class="vy__legs">
    <li>
      <i>01</i>
      <h3>Mirror</h3>
      <p>Tracked and untracked files travel as a thin Git pack; ignored files never leave. Only files whose content changed are rewritten, so build tools see unchanged mtimes.</p>
    </li>
    <li>
      <i>02</i>
      <h3>Run</h3>
      <p>The command runs in the sandbox's checkout. Its output streams back byte for byte, and <code>cheers</code> exits with the command's own status.</p>
    </li>
    <li>
      <i>03</i>
      <h3>Copy back</h3>
      <p>Files the command changed come home as a patch. If you edited the same lines meanwhile, nothing is touched and the patch is kept.</p>
    </li>
  </ol>
</div>

<style>
  .vy {
    position: relative;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    border: 1px solid var(--bp-line-strong);
    border-radius: 24px;
    background:
      radial-gradient(120% 90% at 50% 0%, var(--bp-buoy-soft), transparent 60%),
      color-mix(in srgb, var(--bp-card) 72%, transparent);
    backdrop-filter: blur(6px);
  }

  .vy__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0 0.25rem;
  }

  .vy__title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-style: italic;
  }

  .vy__phases {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vy__phases li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--bp-line);
    border-radius: 999px;
    color: var(--bp-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.35s ease;
  }

  .vy__phases i {
    margin-right: 0.3rem;
    font-style: normal;
    opacity: 0.6;
  }

  .vy[data-phase="mirror"] [data-leg="mirror"],
  .vy[data-phase="run"] [data-leg="run"],
  .vy[data-phase="copy"] [data-leg="copy"] {
    border-color: var(--bp-buoy);
    background: var(--bp-buoy);
    color: var(--bp-sea);
  }

  .vy__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(8.5rem, 0.5fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
  }

  .vy__local {
    min-height: 19rem;
    box-shadow: none;
  }

  .vy__cursor {
    display: inline-block !important;
    width: 0.55em;
    height: 1.1em;
    margin-top: 0.2rem;
    background: var(--bp-buoy);
    animation: vy-blink 1.1s steps(1) infinite;
  }

  @keyframes vy-blink {
    50% {
      opacity: 0;
    }
  }

  /* Live mode: the script sets data-step and toggles .is-on on [data-at]. */

  .vy.is-live .vy__files [data-at]:not(.is-on) {
    opacity: 0.25;
  }

  .vy.is-live .vy__files [data-at]:not(.is-on) .vy__tag,
  .vy.is-live .vy__files [data-at]:not(.is-on) .vy__note {
    visibility: hidden;
  }

  .vy.is-live .bp-term__body [data-at]:not(.is-on) {
    display: none;
  }

  .vy.is-live .bp-term__body [data-at].is-on {
    animation: vy-line 0.3s ease both;
  }

  @keyframes vy-line {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  .vy.is-live .vy__new:not(.is-on) {
    display: none;
  }

  .vy.is-live [data-at="1"].is-on .vy__typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
    animation: vy-type 0.9s steps(34) both;
  }

  @keyframes vy-type {
    from {
      max-width: 0;
    }
    to {
      max-width: 34ch;
    }
  }

  /* Channel */

  .vy__channel {
    display: grid;
    align-content: center;
    gap: 2.2rem;
    padding: 0 0.6rem;
  }

  .vy__lane {
    position: relative;
    display: grid;
    height: 2.4rem;
    align-items: center;
    color: var(--bp-muted);
    transition: color 0.3s ease;
  }

  .vy__lane-label {
    position: absolute;
    top: -0.6rem;
    left: 0;
    right: 0;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .vy__rope {
    height: 1px;
    margin-top: 0.7rem;
    background-image: linear-gradient(90deg, currentColor 50%, transparent 50%);
    background-size: 8px 1px;
    opacity: 0.6;
  }

  .vy__arrow {
    position: absolute;
    right: -0.2rem;
    bottom: 0.15rem;
    font-size: 0.9rem;
    line-height: 1;
  }

  .vy__arrow--back {
    right: auto;
    left: -0.2rem;
  }

  .vy__packet {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: var(--bp-buoy);
    color: var(--bp-sea);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-stretch: 87.5%;
    transform: translate(-50%, -10%);
    white-space: nowrap;
  }

  .vy__packet--in {
    background: var(--bp-run);
  }

  .vy__drops {
    position: absolute;
    inset: 50% 0 auto;
    height: 6px;
    margin-top: 2px;
  }

  .vy__drops i {
    position: absolute;
    top: 0;
    left: calc(var(--n, 0) * 20% + 6%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bp-lamp);
  }

  .vy__drops i:nth-child(2) { --n: 1; }
  .vy__drops i:nth-child(3) { --n: 2; }
  .vy__drops i:nth-child(4) { --n: 3; }
  .vy__drops i:nth-child(5) { --n: 4; }

  .vy.is-live .vy__lane:not(.is-on) {
    color: var(--bp-faint);
  }

  .vy.is-live .vy__lane:not(.is-on) .vy__packet,
  .vy.is-live .vy__lane:not(.is-on) .vy__drops {
    opacity: 0;
  }

  .vy.is-live .vy__lane.is-on {
    color: var(--bp-ink);
  }

  .vy.is-live .vy__lane.is-on .vy__packet--out {
    animation: vy-out 1.3s cubic-bezier(0.5, 0, 0.3, 1) both;
  }

  .vy.is-live .vy__lane.is-on .vy__packet--in {
    animation: vy-in 1.3s cubic-bezier(0.5, 0, 0.3, 1) both;
  }

  .vy.is-live .vy__lane.is-on .vy__drops i {
    animation: vy-drop 1.2s linear infinite;
    animation-delay: calc(var(--n, 0) * -0.24s);
  }

  @keyframes vy-out {
    from {
      left: 8%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    to {
      left: 92%;
      opacity: 1;
    }
  }

  @keyframes vy-in {
    from {
      left: 92%;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    to {
      left: 8%;
      opacity: 1;
    }
  }

  @keyframes vy-drop {
    from {
      left: 96%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    to {
      left: 2%;
      opacity: 0;
    }
  }

  /* Remote card */

  .vy__remote {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--bp-line-strong);
    border-radius: 16px;
    background: var(--bp-card);
  }

  .vy__remote-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4rem 0.8rem;
  }

  .vy__remote-head strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .vy__remote-head small {
    color: var(--bp-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-stretch: 87.5%;
  }

  .vy__lamp {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--bp-lamp);
    box-shadow: 0 0 0 4px var(--bp-lamp-soft), 0 0 18px var(--bp-lamp);
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  .vy[data-phase="run"] .vy__lamp,
  .vy[data-phase="mirror"] .vy__lamp,
  .vy[data-phase="copy"] .vy__lamp {
    background: var(--bp-run);
    box-shadow: 0 0 0 4px var(--bp-run-soft), 0 0 18px var(--bp-run);
    animation: vy-pulse 1.2s ease-in-out infinite;
  }

  @keyframes vy-pulse {
    50% {
      box-shadow: 0 0 0 8px transparent, 0 0 10px var(--bp-run);
    }
  }

  .vy__state {
    grid-column: 1 / -1;
    color: var(--bp-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
  }

  .vy__state > span {
    display: none;
  }

  .vy[data-phase="all"] .vy__state-all,
  .vy[data-phase="done"] .vy__state-warm,
  .vy[data-phase="idle"] .vy__state-warm,
  .vy[data-phase="mirror"] .vy__state-run,
  .vy[data-phase="run"] .vy__state-run,
  .vy[data-phase="copy"] .vy__state-run {
    display: inline;
  }

  .vy__state-run {
    color: var(--bp-run);
  }

  .vy__state-warm {
    color: var(--bp-lamp);
  }

  .vy__files {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vy__files li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem 0.6rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--bp-line);
    border-radius: 10px;
    transition: opacity 0.35s ease, transform 0.35s ease, border-color 0.35s ease, background 0.35s ease;
  }

  .vy__files code {
    overflow: hidden;
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .vy__tag {
    align-self: center;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vy__note {
    grid-column: 1 / -1;
    color: var(--bp-muted);
    font-size: 0.74rem;
  }

  li[data-tone="buoy"] .vy__tag {
    background: var(--bp-buoy-soft);
    color: var(--bp-buoy);
  }

  li[data-tone="dim"] .vy__tag {
    background: var(--bp-deep);
    color: var(--bp-muted);
  }

  li[data-tone="lamp"] .vy__tag {
    background: var(--bp-lamp-soft);
    color: var(--bp-lamp);
  }

  li[data-tone="run"] {
    border-color: color-mix(in srgb, var(--bp-run) 45%, transparent);
    background: var(--bp-run-soft);
  }

  li[data-tone="run"] .vy__tag {
    background: var(--bp-run);
    color: var(--bp-sea);
  }

  li[data-tone="buoy"].is-on {
    border-color: color-mix(in srgb, var(--bp-buoy) 40%, transparent);
  }

  /* Captions */

  .vy__legs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.75rem 0 0;
    padding: 1.5rem 0.25rem 0.25rem;
    border-top: 1px solid var(--bp-line);
    list-style: none;
  }

  .vy__legs i {
    color: var(--bp-buoy);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-style: normal;
  }

  .vy__legs h3 {
    margin: 0.3rem 0 0.45rem;
    font-size: 1.5rem;
  }

  .vy__legs p {
    color: var(--bp-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .vy__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .vy__local {
      min-height: 13rem;
    }

    .vy__channel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      padding: 1.6rem 0 0.4rem;
    }

    .vy__lane {
      height: 2rem;
    }

    .vy__legs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .vy__phases {
      display: none;
    }

    .vy__lane-label {
      font-size: 0.48rem;
    }
  }
</style>
