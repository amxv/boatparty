---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import Agents from "../components/landing/Agents.astro";
import Crew from "../components/landing/Crew.astro";
import Harbor from "../components/landing/Harbor.astro";
import Hero from "../components/landing/Hero.astro";
import Legs from "../components/landing/Legs.astro";
import Lifecycle from "../components/landing/Lifecycle.astro";
import Limits from "../components/landing/Limits.astro";
import Start from "../components/landing/Start.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/landing.css";

const fonts =
  "https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..600&family=Funnel+Sans:ital,wght@0,300..700;1,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap";
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <link rel="stylesheet" href={fonts} />
  <div class="bp">
    <Hero />
    <Legs />
    <Harbor />
    <Lifecycle />
    <Limits />
    <Agents />
    <Crew />
    <Start />
  </div>
</BaseLayout>

<script>
  import "../scripts/landing";
</script>
